@model BelediyeEnvanter.Controllers.AccountController.LoginModel
@{Layout=null;}<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Giriş - Belediye Envanter</title><style>*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:linear-gradient(135deg,#0f1f50,#2563eb);min-height:100vh;display:flex;align-items:center;justify-content:center;color:#172554}.login-wrap{width:430px;padding:18px}.login-card{background:#fff;border-radius:22px;padding:38px;box-shadow:0 25px 70px rgba(0,0,0,.25)}.logo{width:58px;height:58px;border-radius:17px;background:#2563eb;color:#fff;display:grid;place-items:center;font-size:30px;font-weight:800;margin:0 auto 18px}.title{text-align:center;margin:0;font-size:25px}.subtitle{text-align:center;color:#64748b;margin:8px 0 28px}.label{display:block;font-weight:600;font-size:13px;margin:15px 0 7px}.input{width:100%;border:1px solid #dbe3ef;border-radius:10px;padding:12px 13px;font-size:15px;outline:0}.input:focus{border-color:#2563eb;box-shadow:0 0 0 4px #dbeafe}.remember{display:flex;gap:8px;align-items:center;color:#64748b;font-size:13px;margin:16px 0}.button{width:100%;border:0;border-radius:10px;background:#2563eb;color:#fff;padding:13px;font-size:15px;font-weight:700;cursor:pointer}.button:hover{background:#1d4ed8}.error{background:#fef2f2;color:#b91c1c;border-radius:9px;padding:10px;font-size:13px;margin-bottom:12px}.hint{margin-top:20px;padding:12px;background:#eff6ff;border-radius:10px;color:#1e40af;font-size:12px}.hint strong{display:block;margin-bottom:4px}.footer{text-align:center;color:#94a3b8;font-size:12px;margin-top:22px}</style></head><body><div class="login-wrap"><div class="login-card"><div class="logo">K</div><h1 class="title">Belediye Envanter</h1><p class="subtitle">Yönetim paneline güvenli giriş</p><form asp-action="Login" method="post"><input type="hidden" asp-for="returnUrl"/><div asp-validation-summary="All" class="error"></div><label class="label">Kullanıcı Adı</label><input asp-for="UserName" class="input" autocomplete="username" placeholder="Kullanıcı adınızı yazın"/><label class="label">Şifre</label><input asp-for="Password" type="password" class="input" autocomplete="current-password" placeholder="Şifrenizi yazın"/><label class="remember"><input asp-for="RememberMe"/> Beni hatırla</label><button class="button" type="submit">Giriş Yap</button></form><div class="hint"><strong>Geliştirme hesabı</strong>Kullanıcı adı: <b>admin</b><br/>Şifre: <b>Admin1234</b></div></div><div class="footer">Kayseri Büyükşehir Belediyesi · Envanter Yönetim Sistemi</div></div></body></html>
