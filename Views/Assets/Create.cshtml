@model BelediyeEnvanter.Models.Asset
@{ViewData["Title"]="Yeni Demirbaş";}<h1>Yeni Demirbaş</h1><p class="text-muted">Zorunlu alanlar * ile işaretlidir.</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="alert alert-danger"></div><div class="card p-4 shadow-sm border-0"><div class="row g-3"><div class="col-md-6"><label class="form-label">Demirbaş Adı *</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Kategori *</label><select asp-for="Category" class="form-select"><option value="">Kategori seçiniz</option>@foreach(var k in (IEnumerable<BelediyeEnvanter.Models.Category>)ViewBag.KategoriListesi){<option value="@k.Name">@k.Name</option>}</select><span asp-validation-for="Category" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Marka / Model</label><input asp-for="BrandModel" class="form-control"/></div><div class="col-md-6"><label class="form-label">Seri Numarası</label><input asp-for="SerialNumber" class="form-control"/></div><div class="col-md-6"><label class="form-label">Zimmet Numarası</label><input asp-for="InventoryNumber" class="form-control"/></div><div class="col-md-6"><label class="form-label">Zimmet Sorumlusu</label><input asp-for="ResponsiblePerson" class="form-control"/></div><div class="col-md-6"><label class="form-label">Kullanan Personel</label><input asp-for="KullananPersonel" class="form-control"/></div><div class="col-md-6"><label class="form-label">Oda *</label><select asp-for="RoomId" class="form-select"><option value="0">Oda seçiniz</option>@foreach(var r in (IEnumerable<BelediyeEnvanter.Models.Room>)ViewBag.Rooms){<option value="@r.Id">@r.Building - @r.RoomNumber (@r.Directorate?.Name)</option>}</select><span asp-validation-for="RoomId" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Durum</label><select asp-for="Status" class="form-select"><option>Aktif</option><option>Arızalı</option><option>Depoda</option><option>Hurda</option></select></div></div></div><button class="btn btn-primary mt-3">Kaydet</button> <a class="btn btn-light mt-3" asp-action="Index">Vazgeç</a></form>
