@model IEnumerable<BelediyeEnvanter.Models.Asset>
@{ViewData["Title"]="Demirbaşlar";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Demirbaşlar</h1><p class="text-muted">Yazdıkça veya seçim yaptıkça sonuçlar anında güncellenir.</p></div><a class="btn btn-primary" asp-action="Create">＋ Yeni Demirbaş</a></div>
<div class="card p-3 mb-4 shadow-sm border-0"><div class="d-flex justify-content-between align-items-center mb-3"><strong>Hızlı Filtreleme</strong><button type="button" id="temizle" class="btn btn-sm btn-light">↺ Temizle</button></div><div class="row g-2 align-items-end"><div class="col-lg-4 col-md-6"><label class="form-label">Genel Arama</label><input id="arama" class="form-control" placeholder="Ad, seri no, zimmet veya kişi yazın..." autocomplete="off" /></div><div class="col-lg-2 col-md-6"><label class="form-label">Kategori</label><select id="kategori" class="form-select"><option value="">Tüm kategoriler</option>@foreach(var k in (IEnumerable<string>)ViewBag.Kategoriler){<option value="@k">@k</option>}</select></div><div class="col-lg-2 col-md-6"><label class="form-label">Durum</label><select id="durum" class="form-select"><option value="">Tüm durumlar</option><option>Aktif</option><option>Arızalı</option><option>Depoda</option><option>Hurda</option></select></div><div class="col-lg-2 col-md-6"><label class="form-label">Oda</label><select id="oda" class="form-select"><option value="">Tüm odalar</option>@foreach(var o in (IEnumerable<BelediyeEnvanter.Models.Room>)ViewBag.Odalar){<option value="@o.Id">@o.Building - @o.RoomNumber</option>}</select></div><div class="col-lg-2 col-md-6"><label class="form-label">Kullanan Personel</label><select id="personel" class="form-select"><option value="">Tüm personel</option>@foreach(var p in (IEnumerable<string>)ViewBag.Personeller){<option value="@p">@p</option>}</select></div></div><div class="small text-muted mt-2"><span id="sonucSayisi">0</span> kayıt gösteriliyor</div></div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Demirbaş</th><th>Kategori</th><th>Seri No</th><th>Zimmet No</th><th>Kullanan</th><th>Oda</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead><tbody id="demirbasTablosu">@foreach(var a in Model){<tr data-kategori="@a.Category" data-durum="@a.Status" data-oda="@a.RoomId" data-personel="@a.KullananPersonel"><td><strong>@a.Name</strong><small class="d-block text-muted">@a.BrandModel</small></td><td>@a.Category</td><td>@a.SerialNumber</td><td>@a.InventoryNumber</td><td>@a.KullananPersonel</td><td>@a.Room?.RoomNumber</td><td><span class="badge @(a.Status=="Aktif"?"bg-success":"bg-warning text-dark")">@a.Status</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Düzenle</a> <a class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu demirbaş silinsin mi?')" asp-action="Delete" asp-route-id="@a.Id">Sil</a></td></tr>}</tbody></table></div><div id="kayitYok" class="text-center text-muted p-4" style="display:none">Aramanıza uygun demirbaş bulunamadı.</div></div>
@section Scripts {<script>const norm=s=>(s||'').toLocaleLowerCase('tr-TR').trim();const filtrele=()=>{const q=norm(document.getElementById('arama').value),k=document.getElementById('kategori').value,d=document.getElementById('durum').value,o=document.getElementById('oda').value,p=document.getElementById('personel').value;let say=0;document.querySelectorAll('#demirbasTablosu tr').forEach(r=>{const uygun=norm(r.innerText).includes(q)&&(!k||r.dataset.kategori===k)&&(!d||r.dataset.durum===d)&&(!o||r.dataset.oda===o)&&(!p||r.dataset.personel===p);r.style.display=uygun?'':'none';if(uygun)say++});document.getElementById('sonucSayisi').textContent=say;document.getElementById('kayitYok').style.display=say?'none':''};document.getElementById('arama').addEventListener('input',filtrele);['kategori','durum','oda','personel'].forEach(id=>document.getElementById(id).addEventListener('change',filtrele));document.getElementById('temizle').addEventListener('click',()=>{document.getElementById('arama').value='';['kategori','durum','oda','personel'].forEach(id=>document.getElementById(id).value='');filtrele()});filtrele();</script>}
