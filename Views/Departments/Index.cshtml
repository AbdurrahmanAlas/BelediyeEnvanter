@model IEnumerable<BelediyeEnvanter.Models.Department>
<style>
.birim-modal{display:none;position:fixed;inset:0;z-index:20000;background:rgba(15,30,65,.58);align-items:center;justify-content:center;padding:1rem}
.birim-modal.acik{display:flex}
.birim-modal-kutu{width:min(560px,100%);background:#fff;border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.28);overflow:hidden}
.birim-modal-baslik{display:flex;align-items:center;justify-content:space-between;padding:1.15rem 1.35rem;border-bottom:1px solid #e6ebf3}
.birim-modal-baslik h5{margin:0;font-weight:700}.birim-kapat{border:0;background:transparent;font-size:1.7rem;line-height:1;color:#64748b;cursor:pointer}.birim-modal-govde{padding:1.35rem}.birim-modal-alt{display:flex;justify-content:flex-end;gap:.6rem;padding:1rem 1.35rem;background:#f8fafc;border-top:1px solid #e6ebf3}
</style>
@{ ViewData["Title"] = "Birimler"; var tumBirimler = Model.ToList(); }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Birimler</h1><p class="text-muted mb-0">Daire başkanlıkları ve bağlı müdürlükleri yönetin.</p></div><div class="d-flex gap-2"><button type="button" class="btn btn-outline-primary" onclick="modalAc('mudurlukEkle')">＋ Müdürlük Ekle</button><button type="button" class="btn btn-primary" onclick="modalAc('daireEkle')">＋ Daire Başkanlığı Ekle</button></div></div>
<div class="row g-4">@foreach(var d in Model){<div class="col-md-6 col-xl-4"><div class="card h-100 shadow-sm border-0"><div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center"><span class="fw-semibold">@d.Name</span><div class="dropdown"><button class="btn btn-sm text-white" data-bs-toggle="dropdown">⋮</button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#daireDuzenle" data-id="@d.Id" data-name="@d.Name">Düzenle</button></li><li><a class="dropdown-item text-danger" onclick="return confirm('Daire başkanlığı silinsin mi? Bağlı müdürlüğü olmamalıdır.')" asp-action="DeleteDepartment" asp-route-id="@d.Id">Sil</a></li></ul></div></div><div class="card-body"><div class="small text-muted mb-2">Bağlı Müdürlükler (@d.Directorates.Count)</div><div class="list-group list-group-flush">@foreach(var m in d.Directorates.OrderBy(x=>x.Name)){<div class="list-group-item px-0 d-flex justify-content-between align-items-center"><span><span class="text-primary me-2">▸</span>@m.Name</span><span class="dropdown"><button class="btn btn-sm" data-bs-toggle="dropdown">⋮</button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#mudurlukDuzenle" data-id="@m.Id" data-name="@m.Name" data-department="@d.Id">Düzenle</button></li><li><a class="dropdown-item text-danger" onclick="return confirm('Müdürlük silinsin mi? Bağlı odası olmamalıdır.')" asp-action="DeleteDirectorate" asp-route-id="@m.Id">Sil</a></li></ul></span></div>}</div></div></div></div>}</div>
<div class="birim-modal" id="daireEkle" onclick="modalDisiKapat(event)"><div class="birim-modal-kutu"><form asp-action="AddDepartment" method="post"><div class="birim-modal-baslik"><h5>Daire Başkanlığı Ekle</h5><button type="button" class="birim-kapat" onclick="modalKapat('daireEkle')">×</button></div><div class="birim-modal-govde"><label class="form-label">Daire başkanlığı adı</label><input name="name" class="form-control" required placeholder="Örn. Fen İşleri Daire Başkanlığı" autofocus /></div><div class="birim-modal-alt"><button type="button" class="btn btn-light" onclick="modalKapat('daireEkle')">Vazgeç</button><button class="btn btn-primary">Kaydet</button></div></form></div></div>
<div class="birim-modal" id="mudurlukEkle" onclick="modalDisiKapat(event)"><div class="birim-modal-kutu"><form asp-action="AddDirectorate" method="post"><div class="birim-modal-baslik"><h5>Müdürlük Ekle</h5><button type="button" class="birim-kapat" onclick="modalKapat('mudurlukEkle')">×</button></div><div class="birim-modal-govde"><label class="form-label">Bağlı olduğu daire başkanlığı</label><select name="departmentId" class="form-select mb-3" required><option value="">Seçiniz</option>@foreach(var d in tumBirimler){<option value="@d.Id">@d.Name</option>}</select><label class="form-label">Müdürlük adı</label><input name="name" class="form-control" required placeholder="Örn. Yapı İşleri Müdürlüğü" /></div><div class="birim-modal-alt"><button type="button" class="btn btn-light" onclick="modalKapat('mudurlukEkle')">Vazgeç</button><button class="btn btn-primary">Kaydet</button></div></form></div></div>
<div class="birim-modal" id="daireDuzenle" onclick="modalDisiKapat(event)"><div class="birim-modal-kutu"><form asp-action="UpdateDepartment" method="post"><div class="birim-modal-baslik"><h5>Daire Başkanlığını Düzenle</h5><button type="button" class="birim-kapat" onclick="modalKapat('daireDuzenle')">×</button></div><div class="birim-modal-govde"><input name="id" id="daireId" type="hidden"/><label class="form-label">Daire başkanlığı adı</label><input name="name" id="daireAdi" class="form-control" required /></div><div class="birim-modal-alt"><button type="button" class="btn btn-light" onclick="modalKapat('daireDuzenle')">Vazgeç</button><button class="btn btn-primary">Kaydet</button></div></form></div></div>
<div class="birim-modal" id="mudurlukDuzenle" onclick="modalDisiKapat(event)"><div class="birim-modal-kutu"><form asp-action="UpdateDirectorate" method="post"><div class="birim-modal-baslik"><h5>Müdürlüğü Düzenle</h5><button type="button" class="birim-kapat" onclick="modalKapat('mudurlukDuzenle')">×</button></div><div class="birim-modal-govde"><input name="id" id="mudurlukId" type="hidden"/><label class="form-label">Daire Başkanlığı</label><select name="departmentId" id="mudurlukDaire" class="form-select mb-3">@foreach(var d in tumBirimler){<option value="@d.Id">@d.Name</option>}</select><label class="form-label">Müdürlük adı</label><input name="name" id="mudurlukAdi" class="form-control" required /></div><div class="birim-modal-alt"><button type="button" class="btn btn-light" onclick="modalKapat('mudurlukDuzenle')">Vazgeç</button><button class="btn btn-primary">Kaydet</button></div></form></div></div>
@section Scripts {<script>function modalAc(id){document.getElementById(id).classList.add('acik');document.body.style.overflow='hidden';setTimeout(()=>{const e=document.querySelector('#'+id+' input:not([type=hidden]),#'+id+' select');if(e)e.focus()},30)}function modalKapat(id){document.getElementById(id).classList.remove('acik');document.body.style.overflow=''}function modalDisiKapat(e){if(e.target===e.currentTarget)modalKapat(e.currentTarget.id)}document.querySelectorAll('[data-bs-target="#daireDuzenle"]').forEach(x=>x.addEventListener('click',()=>{document.getElementById('daireId').value=x.dataset.id;document.getElementById('daireAdi').value=x.dataset.name;modalAc('daireDuzenle')}));document.querySelectorAll('[data-bs-target="#mudurlukDuzenle"]').forEach(x=>x.addEventListener('click',()=>{document.getElementById('mudurlukId').value=x.dataset.id;document.getElementById('mudurlukAdi').value=x.dataset.name;document.getElementById('mudurlukDaire').value=x.dataset.department;modalAc('mudurlukDuzenle')}));document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.birim-modal.acik').forEach(x=>modalKapat(x.id))});</script>}
