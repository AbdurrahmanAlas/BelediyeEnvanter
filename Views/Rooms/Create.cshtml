@model BelediyeEnvanter.Models.Room
@{ ViewData["Title"] = "Yeni Oda"; }<div class="mb-4"><h1>Yeni Oda</h1><p class="text-muted">Odayı bağlı olduğu müdürlük ve daire başkanlığı ile birlikte tanımlayın.</p></div><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="card shadow-sm border-0"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Bina Adı</label><input asp-for="Building" class="form-control" placeholder="Örn. Başkanlık Binası" /></div><div class="col-md-3"><label class="form-label">Kat</label><input asp-for="Floor" class="form-control" placeholder="Örn. 3" /></div><div class="col-md-3"><label class="form-label">Oda Numarası</label><input asp-for="RoomNumber" class="form-control" placeholder="Örn. 305" /><span asp-validation-for="RoomNumber" class="text-danger"></span></div><div class="col-12"><label class="form-label">Bağlı Müdürlük</label><select asp-for="DirectorateId" class="form-select"><option value="">Daire başkanlığı ve müdürlük seçiniz</option>@foreach(var grup in ((IEnumerable<BelediyeEnvanter.Models.Directorate>)ViewBag.Mudurlukler).GroupBy(x => x.Department?.Name).OrderBy(x => x.Key)){<optgroup label="@grup.Key">@foreach(var m in grup.OrderBy(x => x.Name)){<option value="@m.Id">@m.Name</option>}</optgroup>}</select></div></div></div></div><button class="btn btn-primary mt-3">Odayı Kaydet</button> <a class="btn btn-outline-secondary mt-3" asp-action="Index">Vazgeç</a></form>
