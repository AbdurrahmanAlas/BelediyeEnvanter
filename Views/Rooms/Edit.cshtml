@model BelediyeEnvanter.Models.Room
@{ViewData["Title"]="Oda Düzenle";}<h1>Oda Düzenle</h1><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden"/><div class="card p-4 shadow-sm border-0"><div class="row g-3"><div class="col-md-6"><label class="form-label">Bina Adı</label><input asp-for="Building" class="form-control"/></div><div class="col-md-3"><label class="form-label">Kat</label><input asp-for="Floor" class="form-control"/></div><div class="col-md-3"><label class="form-label">Oda Numarası</label><input asp-for="RoomNumber" class="form-control"/></div><div class="col-12"><label class="form-label">Müdürlük</label><select asp-for="DirectorateId" class="form-select">@foreach(var m in (IEnumerable<BelediyeEnvanter.Models.Directorate>)ViewBag.Mudurlukler){<option value="@m.Id">@m.Department?.Name - @m.Name</option>}</select></div></div></div><button class="btn btn-primary mt-3">Değişiklikleri Kaydet</button> <a class="btn btn-light mt-3" asp-action="Index">Vazgeç</a></form>
