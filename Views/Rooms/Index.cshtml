@model IEnumerable<BelediyeEnvanter.Models.Room>
@{ViewData["Title"]="Odalar";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Odalar</h1><p class="text-muted">Yazdıkça veya seçim yaptıkça sonuçlar anında güncellenir.</p></div><a class="btn btn-primary" asp-action="Create">＋ Yeni Oda</a></div>
<div class="card p-3 mb-4 shadow-sm border-0"><div class="d-flex justify-content-between align-items-center mb-3"><strong>Hızlı Filtreleme</strong><button type="button" id="temizle" class="btn btn-sm btn-light">↺ Temizle</button></div><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Bina</label><input id="bina" class="form-control" placeholder="Bina adına göre yazın..." autocomplete="off" /></div><div class="col-md-2"><label class="form-label">Kat</label><input id="kat" class="form-control" placeholder="Örn. 3" autocomplete="off" /></div><div class="col-md-4"><label class="form-label">Müdürlük</label><select id="mudurluk" class="form-select"><option value="">Tüm müdürlükler</option>@foreach(var m in (IEnumerable<BelediyeEnvanter.Models.Directorate>)ViewBag.Mudurlukler){<option value="@m.Id">@m.Name</option>}</select></div><div class="col-md-2"><span class="small text-muted"><strong id="sonucSayisi">0</strong> oda gösteriliyor</span></div></div></div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bina</th><th>Kat</th><th>Oda No</th><th>Müdürlük</th><th>Demirbaş</th><th class="text-end">İşlemler</th></tr></thead><tbody id="odaTablosu">@foreach(var o in Model){<tr data-bina="@o.Building" data-kat="@o.Floor" data-mudurluk="@o.DirectorateId"><td>@o.Building</td><td>@o.Floor</td><td><span class="badge bg-light text-dark">@o.RoomNumber</span></td><td>@o.Directorate?.Name</td><td>@o.Assets.Count kayıt</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@o.Id">Düzenle</a> <a class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu oda silinsin mi? Oda boş olmalıdır.')" asp-action="Delete" asp-route-id="@o.Id">Sil</a></td></tr>}</tbody></table></div><div id="kayitYok" class="text-center text-muted p-4" style="display:none">Aramanıza uygun oda bulunamadı.</div></div>
@section Scripts {<script>const norm=s=>(s||'').toLocaleLowerCase('tr-TR').trim();const filtrele=()=>{const b=norm(document.getElementById('bina').value),k=norm(document.getElementById('kat').value),m=document.getElementById('mudurluk').value;let say=0;document.querySelectorAll('#odaTablosu tr').forEach(r=>{const uygun=norm(r.dataset.bina).includes(b)&&norm(r.dataset.kat).includes(k)&&(!m||r.dataset.mudurluk===m);r.style.display=uygun?'':'none';if(uygun)say++});document.getElementById('sonucSayisi').textContent=say;document.getElementById('kayitYok').style.display=say?'none':''};['bina','kat'].forEach(id=>document.getElementById(id).addEventListener('input',filtrele));document.getElementById('mudurluk').addEventListener('change',filtrele);document.getElementById('temizle').addEventListener('click',()=>{document.getElementById('bina').value='';document.getElementById('kat').value='';document.getElementById('mudurluk').value='';filtrele()});filtrele();</script>}
