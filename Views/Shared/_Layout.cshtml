<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - Belediye Envanter</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/theme.css" asp-append-version="true"/></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">K</span><span><strong>Belediye</strong><small>Envanter Yönetimi</small></span></a><div class="menu-label">ANA MENÜ</div><nav class="side-nav"><a asp-controller="Home" asp-action="Index"><span>⌂</span> Genel Bakış</a><a asp-controller="Departments" asp-action="Index"><span>▦</span> Birimler</a><a asp-controller="Rooms" asp-action="Index"><span>▣</span> Odalar</a><a asp-controller="Assets" asp-action="Index"><span>▤</span> Demirbaşlar</a>@if(User.IsInRole("Yönetici")){<a asp-controller="Users" asp-action="Index"><span>♙</span> Kullanıcılar</a>}</nav><div class="sidebar-bottom"><div class="status-dot"></div><div><strong>Sistem aktif</strong><small>@User.Identity?.Name</small></div></div></aside><main class="main-content"><header class="topbar"><button class="mobile-menu" onclick="document.querySelector('.sidebar').classList.toggle('open')">☰</button><div><div class="page-kicker">KAYSERİ BÜYÜKŞEHİR BELEDİYESİ</div><h6 class="mb-0">@ViewData["Title"]</h6></div><div class="user-pill"><span class="user-avatar">@(User.Identity?.Name?.FirstOrDefault() ?? 'Y')</span><span>@User.Identity?.Name</span><form asp-controller="Account" asp-action="Logout" method="post" class="ms-2"><button class="btn btn-sm btn-outline-secondary">Çıkış</button></form></div></header><div class="content-wrap">@RenderBody()</div><footer>Belediye Envanter Yönetim Sistemi <span>•</span> 2026</footer></main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
