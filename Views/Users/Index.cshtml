@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
<style>.user-modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.6);z-index:9999;align-items:center;justify-content:center}.user-modal.open{display:flex}.user-modal-box{background:#fff;width:min(500px,calc(100% - 30px));border-radius:18px;box-shadow:0 25px 70px rgba(0,0,0,.3);overflow:hidden}.user-modal-head{padding:20px 24px;background:#eff6ff;display:flex;justify-content:space-between}.user-modal-body{padding:24px}.user-modal-foot{padding:16px 24px;border-top:1px solid #e5e7eb;text-align:right}</style>
@{ViewData["Title"]="Kullanıcı Yönetimi";var roles=(Dictionary<string,string>)ViewBag.RoleMap;}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Kullanıcı Yönetimi</h1><p class="text-muted">Kullanıcı ve rol işlemleri.</p></div><button type="button" class="btn btn-primary" onclick="acKullaniciFormu()">＋ Kullanıcı Ekle</button></div>@if(TempData["Mesaj"]!=null){<div class="alert alert-success">@TempData["Mesaj"]</div>}@if(TempData["Hata"]!=null){<div class="alert alert-danger">@TempData["Hata"]</div>}<div class="card shadow-sm border-0"><table class="table mb-0"><thead><tr><th>Kullanıcı</th><th>E-posta</th><th>Rol</th><th>İşlemler</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.UserName</td><td>@u.Email</td><td><form asp-action="SetRole" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><select name="role" class="form-select form-select-sm" style="width:150px" @(u.UserName=="admin"?"disabled":"")><option selected="@(roles[u.Id]=="Personel")">Personel</option><option selected="@(roles[u.Id]=="Yönetici")">Yönetici</option></select>@if(u.UserName!="admin"){<button class="btn btn-sm btn-outline-primary">Rolü Kaydet</button>}</form></td><td>@if(u.UserName!="admin"){<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id" onclick="return confirm('Kullanıcı silinsin mi?')">Sil</a>}</td></tr>}</tbody></table></div><div id="kullaniciModal" class="user-modal" onclick="if(event.target===this)kapatKullaniciFormu()"><div class="user-modal-box"><div class="user-modal-head"><h5 class="mb-0">Yeni Kullanıcı</h5><button type="button" class="btn-close" onclick="kapatKullaniciFormu()"></button></div><form asp-action="Create" method="post" autocomplete="off">@Html.AntiForgeryToken()<div class="user-modal-body"><label class="form-label">Kullanıcı adı</label><input name="userName" id="yeniKullaniciAdi" class="form-control mb-3" autocomplete="off" placeholder="Örn. ahmet.yilmaz" required/><label class="form-label">Geçici parola</label><input name="password" type="password" class="form-control mb-3" autocomplete="new-password" placeholder="En az 8 karakter" minlength="8" required/><label class="form-label">Rol</label><select name="role" class="form-select"><option value="Personel">Personel</option><option value="Yönetici">Yönetici</option></select></div><div class="user-modal-foot"><button type="button" class="btn btn-light me-2" onclick="kapatKullaniciFormu()">Vazgeç</button><button type="submit" class="btn btn-primary">Kullanıcıyı Oluştur</button></div></form></div></div>
@section Scripts {<script>function acKullaniciFormu(){document.getElementById('kullaniciModal').classList.add('open');setTimeout(()=>document.getElementById('yeniKullaniciAdi').focus(),100)}function kapatKullaniciFormu(){document.getElementById('kullaniciModal').classList.remove('open')}@if(TempData["Mesaj"]!=null){<text>alert('@TempData["Mesaj"]');</text>}@if(TempData["Hata"]!=null){<text>alert('@TempData["Hata"]');</text>}</script>}
