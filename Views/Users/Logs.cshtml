@model IEnumerable<BelediyeEnvanter.Models.AuditLog>
@{ViewData["Title"]="İşlem Kayıtları";}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>İşlem Kayıtları</h1><p class="text-muted">Sistemde yapılan yönetim işlemlerinin geçmişi.</p></div><a class="btn btn-light" asp-action="Index">Kullanıcılara Dön</a></div><div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Tarih</th><th>İşlemi Yapan</th><th>İşlem</th><th>Açıklama</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.Tarih.ToString("dd.MM.yyyy HH:mm")</td><td>@l.Kullanici</td><td><span class="badge bg-primary">@l.Islem</span></td><td>@l.Aciklama</td></tr>}</tbody></table></div></div>
